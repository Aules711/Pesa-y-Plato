# Copia este archivo como .env y rellénalo (Supabase › Project Settings › API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Registro: true = la gente puede crear su cuenta con su email
VITE_ALLOW_SIGNUP=true
# true = para registrarse hace falta un código de invitación (ver supabase/invitaciones.sql)
VITE_INVITE_REQUIRED=false

# Opcional: estimación de comidas con IA (pestaña «Con IA» del diario)
VITE_AI_ENABLED=false
# Solo en Vercel (nunca en el código ni con prefijo VITE_):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5

# Solo en Vercel: permite que cada usuario elimine su cuenta (Perfil › Eliminar mi cuenta)
# Supabase › Project Settings › API › service_role. ¡Nunca con prefijo VITE_ ni en el código!
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
